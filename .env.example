# Kopieer dit bestand naar .env (lokaal) of zet deze variabelen in Vercel → Project → Settings → Environment Variables.
# Nooit echte sleutels in dit bestand of in git committen.
#
# BELANGRIJK (development -> productie migratie): zet deze variabelen PER
# Vercel-omgeving (Production / Preview / Development) op een andere waarde —
# dus development store-gegevens onder "Preview/Development", en de
# productiewinkel-gegevens uitsluitend onder "Production". Zie MIGRATION.md
# voor de volledige stappen. De code zelf verwijst nergens naar een specifieke
# winkel — welke winkel actief is, hangt uitsluitend af van welke omgeving
# draait, dus overstappen vereist GEEN codewijziging of nieuwe build.

# Shopify Storefront API (client-veilig — mag in browser-JS)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=

# Shopify Admin API (GEHEIM — uitsluitend server-side, nooit naar de browser)
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_LOCATION_ID=

# Cron-beveiliging — beveiligt api/sync/*.js tegen willekeurige externe aanroepen.
# Vercel stuurt deze automatisch mee als "Authorization: Bearer $CRON_SECRET"
# zodra je dit instelt bij Project → Settings → Environment Variables EN in de
# cron-configuratie (zie vercel.json/DEPLOYMENT.md). Verzin een lange, willekeurige waarde.
CRON_SECRET=

# Database (Postgres — bv. Supabase). Zonder deze variabele draait de site
# lokaal/in testmodus op een SQLite-testadapter (zie lib/db/adapters/) —
# NOOIT geschikt voor productie, alleen voor ontwikkelen/testen.
DATABASE_URL=

# Testmodus — zie TESTMODE.md. NOOIT true zetten onder de Production-omgeving.
TEST_MODE=false

# Beheerpaneel (/admin)
ADMIN_PANEL_SECRET=
